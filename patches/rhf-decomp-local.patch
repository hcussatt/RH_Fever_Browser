+#include "Baseball/SceneBaseball.hpp"
+#include "Sound.hpp"
+#include "rev_tengoku.rsid"
+#include "cellanim/baseball/ver0/rcad_golfman_labels.h"
+#include "cellanim/baseball/ver0/rcad_golf_monkey_labels.h"
+
+extern "C" {
+
+// 0x8006669c: accepted, mistimed, and unhandled A swing dispatch.
+void fn_8006669C(CSceneBaseball *scene, u32 button, s32 type) {
+    if (button == 4) {
+        if (type == 0) {
+            scene->mGolfer->setAnim(golfman_golfman_just);
+        } else if (type == 1) {
+            scene->mGolfer->setAnim(golfman_golfman_miss);
+        } else if (type == 2) {
+            scene->mGolfer->setAnim(golfman_golfman_out);
+        }
+        gSoundManager->play(SE_GOLF_SWING);
+    }
+}
+
+void fn_80066A1C(CSceneBaseball *scene) {
+    scene->mGolfer->setAnim(golfman_golfman_wait);
+}
+
+void fn_80066A28(CSceneBaseball *scene) {
+    scene->mGolfer->setAnim(golfman_golfman_look);
+}
+
+void fn_80066A34(CSceneBaseball *scene) {
+    scene->mGolfer->setAnim(golfman_golfman_greet);
+}
+
+void fn_80066A40(CSceneBaseball *scene) {
+    CCellAnim *golfer = scene->mGolfer;
+    u16 anim = golfer->getAnimID();
+    if (anim == golfman_golfman_out && golfer->getPlaying()) {
+        golfer->prepareAnim(golfman_golfman_ready, NULL);
+        return;
+    }
+    if (anim != golfman_golfman_ready) {
+        golfer->setAnim(golfman_golfman_ready);
+    }
+}
+
+void fn_80066A7C(CSceneBaseball *scene) {
+    CCellAnim *golfer = scene->mGolfer;
+    if (golfer->getAnimID() != golfman_golfman_ready && !golfer->getPlaying()) {
+        golfer->setAnim(golfman_golfman_beat);
+    }
+}
+
+void fn_80066AA4(CSceneBaseball *scene) {
+    if (scene->mGolfer->getAnimID() == golfman_golfman_ready) {
+        scene->mGolfer->setAnim(golfman_golfman_through);
+        gSoundManager->play(SE_GOLF_AUTO_SWING);
+    }
+}
+
+void fn_80066AEC(CSceneBaseball *scene, s32 enabled) {
+    if (enabled) {
+        scene->mGolfer->setAnim(golfman_golfman_through_Gorilla);
+    }
+}
+
+void fn_80066B18(CSceneBaseball *scene) {
+    CCellAnim *monkey = scene->mMonkey;
+    if (monkey->getAnimID() != golf_monkey_monkey_pitch || !monkey->getPlaying()) {
+        monkey->setAnim(golf_monkey_monkey_ready_S);
+    }
+    gSoundManager->play(SE_GOLF_MONKEY_READY);
+}
+
+void fn_80066B6C(CSceneBaseball *scene) {
+    scene->mMonkey->setAnim(golf_monkey_monkey_pitch);
+    scene->mMonkey->prepareAnim(golf_monkey_monkey_wait, NULL);
+}
+
+void fn_80066BB0(CSceneBaseball *scene) {
+    scene->mMonkey->setScale(1.0f, 1.0f);
+    scene->mMonkey->setAnim(golf_monkey_monkey_turn);
+    scene->mMonkey->prepareAnim(golf_monkey_monkey_wait, NULL);
+}
+
+void fn_80066C0C(CSceneBaseball *scene, s32 count) {
+    scene->mMonkey->setAnim(golf_monkey_monkey_wait);
+    scene->mMonkeyFace->setAnim(golf_monkey_monkey_face_talk);
+    s32 remaining = count - 1;
+    for (s32 i = 0; i < remaining; i++) {
+        scene->mMonkeyFace->prepareAnim(golf_monkey_monkey_face_talk, NULL);
+    }
+}
+
+void fn_80066C88(CSceneBaseball *scene) {
+    CCellAnim *monkey = scene->mMonkey;
+    if (!monkey->getPlaying() || monkey->getAnimID() == golf_monkey_monkey_wait ||
+        monkey->getAnimID() == golf_monkey_monkey_inst_dodo) {
+        monkey->setAnim(golf_monkey_monkey_beat);
+        scene->mMonkey->prepareAnim(golf_monkey_monkey_wait, NULL);
+    }
+}
+
+void fn_80066D98(CSceneBaseball *scene, s32 phase) {
+    switch (phase) {
+    case 0:
+        scene->mGorilla->setAnim(golf_monkey_gorilla_ready_00);
+        break;
+    case 1:
+        scene->mGorilla->setAnim(golf_monkey_gorilla_ready_01);
+        break;
+    case 2:
+        scene->mGorilla->setAnim(golf_monkey_gorilla_ready_02);
+        break;
+    }
+}
+
+} // extern "C"
